import java.util.Scanner;
class Evenodd {
    public static void main(String args[]) {
        int num = 10;
        System.out.println("EVEN TABLES");
        for (int i = 1; i <= 40; i++) {
            if (i % 2 == 0) {
                for (int j = 1; j <= num; j++) {
                    System.out.println(i + " * " + j + " = " + (i * j));
                }
                System.out.println();
            }
        }
        System.out.println("ODD TABLES");
        for (int i = 1; i <= 40; i++) {
            if (i % 2 != 0) {
                for (int j = 1; j <= num; j++) {
                    System.out.println(i + " * " + j + " = " + (i * j));
                }
                System.out.println();
            }
        }
    }
}


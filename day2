public class Dowhile {
    public static void main(String args[]) {

        int i = 1;

        do {
            int j = 1;

            do {
                System.out.println(i + " * " + j + " = " + (i * j));
                j++;
            } while(j <= 10);

            System.out.println();
            i++;

        } while(i <= 5);
    }
}

